VIDEOEDIT_LOG_LEVEL=INFO
VIDEOEDIT_FFMPEG_PATH=ffmpeg
VIDEOEDIT_FFPROBE_PATH=ffprobe
# Software encoding is the reproducible default. Use h264_amf only after doctor passes.
VIDEOEDIT_VIDEO_CODEC=libx264
VIDEOEDIT_VIDEO_BITRATE_BPS=4000000
VIDEOEDIT_NODE_PATH=node
VIDEOEDIT_NPM_PATH=npm
VIDEOEDIT_REMOTION_DIRECTORY=remotion
VIDEOEDIT_WHISPER_MODEL=small
# Set this to an operator-provisioned, hash-verified local Whisper checkpoint.
# VIDEOEDIT_WHISPER_MODEL_PATH=C:\path\to\whisper\small.pt
VIDEOEDIT_MAX_LOCAL_WORKERS=1
VIDEOEDIT_PROVIDER_NETWORK_ENABLED=false
VIDEOEDIT_SAM3_WORKER_COMMAND=
VIDEOEDIT_MATANYONE_WORKER_COMMAND=
VIDEOEDIT_WORKSPACE=.
