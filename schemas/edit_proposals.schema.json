{
  "type": "object",
  "properties": {
    "schema_name": {
      "const": "edit_proposals"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_input"
      }
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_duration_us": {
      "$ref": "#/$defs/time_us"
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edit_proposal"
      }
    },
    "total_proposed_cut_us": {
      "$ref": "#/$defs/time_us"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protected_ranges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/time_range"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "policy_id",
    "policy_version",
    "source_duration_us",
    "proposals",
    "total_proposed_cut_us",
    "warnings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/edit_proposals.schema.json",
  "title": "Edit Proposal Set",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ]
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "artifact_input": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ]
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
    },
    "edit_proposal": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/identifier"
        },
        "proposal_type": {
          "enum": [
            "leading_silence",
            "trailing_silence",
            "long_pause",
            "dead_air",
            "filler_word",
            "filler_phrase",
            "stutter",
            "false_start",
            "abandoned_phrase",
            "self_correction",
            "immediate_repetition",
            "exact_repetition",
            "near_repetition",
            "semantic_repetition",
            "duplicate_take",
            "weak_take",
            "tangent",
            "housekeeping",
            "accidental_noise",
            "hook_tightening"
          ]
        },
        "source_range": {
          "$ref": "#/$defs/time_range"
        },
        "proposed_cut_range": {
          "$ref": "#/$defs/time_range"
        },
        "word_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "excerpt": {
          "type": "string"
        },
        "transcript_before": {
          "type": "string"
        },
        "transcript_inside": {
          "type": "string"
        },
        "transcript_after": {
          "type": "string"
        },
        "handles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_handle_us", "post_handle_us"],
          "properties": {
            "pre_handle_us": {"$ref": "#/$defs/time_us"},
            "post_handle_us": {"$ref": "#/$defs/time_us"}
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meaning_risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "continuity_risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "policy_result": {
          "enum": [
            "auto_eligible",
            "review_required",
            "blocked"
          ]
        },
        "approval_required": {
          "type": "boolean"
        },
        "alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_components": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "recommended_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "safe_fallback": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "edit_intent": {
          "enum": [
            "micro_cleanup",
            "pause_tightening",
            "take_selection",
            "semantic_tightening",
            "noise_removal",
            "hook_tightening"
          ]
        },
        "density_class": {
          "enum": [
            "micro",
            "standard",
            "structural"
          ]
        },
        "join_strategy": {
          "enum": [
            "hard_cut",
            "hard_cut_with_micro_audio_crossfade",
            "adjusted_handles",
            "room_tone",
            "j_cut",
            "l_cut",
            "broll_cover",
            "alternate_coverage",
            "purposeful_punch_in",
            "keep_original"
          ]
        },
        "protected_content_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "categories",
            "notes"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "take_scores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "take_id",
              "range",
              "overall_score",
              "components"
            ],
            "properties": {
              "take_id": {
                "$ref": "#/$defs/identifier"
              },
              "range": {
                "$ref": "#/$defs/time_range"
              },
              "overall_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "components": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "join_preview_required": {
          "type": "boolean"
        },
        "pacing_impact": {
          "enum": [
            "tightens",
            "neutral",
            "may_rush",
            "structural"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "proposal_type",
        "source_range",
        "proposed_cut_range",
        "word_ids",
        "excerpt",
        "reason",
        "confidence",
        "meaning_risk",
        "continuity_risk",
        "evidence_ids",
        "policy_result",
        "approval_required",
        "alternative"
      ]
    }
  }
}
