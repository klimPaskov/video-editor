{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/final_qa_report.schema.json",
  "title": "Final Candidate QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "artifact_id", "project_id", "revision_id",
    "created_at", "producer", "inputs", "candidate", "profile_id", "source_sha256",
    "overall_status", "final_ready", "findings", "required_failures", "warnings_count"
  ],
  "properties": {
    "schema_name": {"const": "final_qa_report"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/revision"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_input"}},
    "candidate": {"$ref": "#/$defs/file_ref"},
    "profile_id": {"$ref": "#/$defs/id"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "overall_status": {"enum": ["pass", "warning", "fail"]},
    "final_ready": {"type": "boolean"},
    "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}},
    "required_failures": {"type": "integer", "minimum": 0},
    "warnings_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "revision": {"type": "string", "pattern": "^rev_[0-9]{3,}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "check_code", "status", "severity", "message", "required", "evidence"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/id"},
        "check_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "status": {"enum": ["pass", "warning", "fail", "skipped"]},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "message": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "evidence": {"type": "object"}
      }
    }
  }
}
