{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/revision_request.schema.json",
  "title": "Immutable Revision Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "parent_revision_id",
    "created_at",
    "producer",
    "source_markers",
    "markers",
    "invalidated_stages",
    "preserved_inputs",
    "status"
  ],
  "properties": {
    "schema_name": {"const": "revision_request"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/revision"},
    "parent_revision_id": {"$ref": "#/$defs/revision"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "source_markers": {"$ref": "#/$defs/file_ref"},
    "markers": {"type": "array", "items": {"$ref": "#/$defs/marker"}},
    "invalidated_stages": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "preserved_inputs": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
    "status": {"const": "created"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "revision": {"type": "string", "pattern": "^rev_[0-9]{3,}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_us", "end_us"],
      "properties": {
        "start_us": {"type": "integer", "minimum": 0},
        "end_us": {"type": "integer", "minimum": 0}
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker_id", "kind", "instruction", "range_us"],
      "properties": {
        "marker_id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "FIX",
            "KEEP",
            "REMOVE",
            "RETIME",
            "MASK",
            "TEXT",
            "AUDIO",
            "ZOOM",
            "SPEED"
          ]
        },
        "instruction": {"type": "string", "minLength": 1},
        "range_us": {"$ref": "#/$defs/range"}
      }
    }
  }
}
