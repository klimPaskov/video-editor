{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/asset_search_result.schema.json",
  "title": "Local asset search result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "catalog_sha256",
    "query",
    "effect_intent",
    "asset_type",
    "required_tags",
    "limit",
    "search_sha256",
    "status",
    "results",
    "warnings"
  ],
  "properties": {
    "schema_name": {"const": "asset_search_result"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "catalog_sha256": {"$ref": "#/$defs/sha256"},
    "query": {"type": "string", "minLength": 1},
    "effect_intent": {"type": "string"},
    "asset_type": {"type": ["string", "null"]},
    "required_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "search_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "complete"},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "asset_sha256",
        "path",
        "description",
        "tags",
        "score",
        "matched_terms",
        "licence_status",
        "licence_reference"
      ],
      "properties": {
        "asset_id": {"$ref": "#/$defs/id"},
        "asset_type": {"type": "string", "minLength": 1},
        "asset_sha256": {"$ref": "#/$defs/sha256"},
        "path": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "score": {"type": "number", "minimum": 0},
        "matched_terms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "licence_status": {"type": "string", "minLength": 1},
        "licence_reference": {"type": "string", "minLength": 1}
      }
    }
  }
}
