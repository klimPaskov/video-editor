{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/foreground_manifest.schema.json",
  "title": "Validated foreground manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "status",
    "source",
    "output",
    "configuration",
    "video",
    "alpha",
    "validation",
    "commands",
    "warnings"
  ],
  "properties": {
    "schema_name": {"const": "foreground_manifest"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "revision_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact_input"}},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["complete", "failed"]},
    "source": {"$ref": "#/$defs/file_ref"},
    "output": {"$ref": "#/$defs/file_ref"},
    "configuration": {"$ref": "#/$defs/chroma_config"},
    "video": {"$ref": "#/$defs/video"},
    "alpha": {"$ref": "#/$defs/alpha"},
    "validation": {"$ref": "#/$defs/validation"},
    "commands": {"type": "array", "items": {"$ref": "#/$defs/process_command"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "time_us": {"type": "integer", "minimum": 0},
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "process_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "working_directory", "exit_code", "elapsed_ms", "version"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "working_directory": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "chroma_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_color", "similarity", "blend", "despill", "despill_color", "despill_mix", "crop", "edge_feather_px", "edge_erode_iterations"],
      "properties": {
        "key_color": {"type": "string", "pattern": "^0x[0-9A-Fa-f]{6}$"},
        "similarity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "blend": {"type": "number", "minimum": 0, "maximum": 1},
        "despill": {"type": "boolean"},
        "despill_color": {"enum": ["green", "blue"]},
        "despill_mix": {"type": "number", "minimum": 0, "maximum": 1},
        "crop": {
          "anyOf": [
            {"type": "null"},
            {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}}
          ]
        },
        "edge_feather_px": {"type": "number", "minimum": 0, "maximum": 64},
        "edge_erode_iterations": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "width", "height", "frame_rate", "pixel_format", "frame_count", "duration_us"],
      "properties": {
        "codec": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frame_rate": {"$ref": "#/$defs/rational"},
        "pixel_format": {"type": "string", "minLength": 1},
        "frame_count": {"type": "integer", "minimum": 1},
        "duration_us": {"$ref": "#/$defs/time_us"}
      }
    },
    "alpha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "mean", "polarity", "sampled_frames"],
      "properties": {
        "min": {"type": "number", "minimum": 0, "maximum": 255},
        "max": {"type": "number", "minimum": 0, "maximum": 255},
        "mean": {"type": "number", "minimum": 0, "maximum": 255},
        "polarity": {"enum": ["mixed", "opaque", "transparent", "unknown"]},
        "sampled_frames": {"type": "integer", "minimum": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_decode", "alpha_plane", "alpha_range", "dimensions", "frame_count", "frame_rate", "duration"],
      "properties": {
        "full_decode": {"enum": ["pass", "fail"]},
        "alpha_plane": {"enum": ["pass", "fail"]},
        "alpha_range": {"enum": ["pass", "fail"]},
        "dimensions": {"enum": ["pass", "fail"]},
        "frame_count": {"enum": ["pass", "fail"]},
        "frame_rate": {"enum": ["pass", "fail"]},
        "duration": {"enum": ["pass", "fail"]}
      }
    }
  }
}
