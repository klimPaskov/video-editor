{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/qa_override.schema.json",
  "title": "Hash-Bound Human QA Override",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "target_report",
    "findings",
    "decision",
    "reviewer",
    "reason",
    "notes",
    "expires_at"
  ],
  "properties": {
    "schema_name": {"const": "qa_override"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/revision"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/input"}
    },
    "target_report": {"$ref": "#/$defs/target_report"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/override_finding"}
    },
    "decision": {"const": "overridden"},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "reason": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "expires_at": {
      "anyOf": [
        {"$ref": "#/$defs/timestamp"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "revision": {"type": "string", "pattern": "^rev_[0-9]{3,}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "target_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "artifact_id", "path", "sha256", "size_bytes"],
      "properties": {
        "schema_name": {
          "enum": [
            "qa_report",
            "segment_qa_report",
            "segment_visual_qa_report",
            "final_qa_report",
            "focus_pacing_qa"
          ]
        },
        "artifact_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_us", "end_us"],
      "properties": {
        "start_us": {"type": "integer", "minimum": 0},
        "end_us": {"type": "integer", "minimum": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["join_ids", "time_ranges"],
      "properties": {
        "join_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"}
        },
        "time_ranges": {
          "type": "array",
          "items": {"$ref": "#/$defs/range"}
        }
      }
    },
    "override_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "check_code",
        "status",
        "severity",
        "classification",
        "reason",
        "evidence"
      ],
      "properties": {
        "finding_id": {"$ref": "#/$defs/id"},
        "check_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "status": {"const": "warning"},
        "severity": {
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "classification": {
          "enum": [
            "reviewed_non_defect",
            "intentional_static",
            "false_positive",
            "accepted_risk"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file_ref"}
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "role", "reviewed_at"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "reviewed_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
