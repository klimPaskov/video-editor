{
  "type": "object",
  "properties": {
    "schema_name": {
      "const": "codex_phase_result"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^(?:P|U)[0-9]+$"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "tasks_completed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:P|U)[0-9]+-[0-9]{2}$"
      }
    },
    "scope_summary": {
      "type": "string",
      "minLength": 1
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test_run"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptance_criterion"
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_recommended_task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "phase_id",
    "status",
    "started_at",
    "completed_at",
    "tasks_completed",
    "scope_summary",
    "files_changed",
    "tests",
    "acceptance_criteria",
    "unresolved_risks",
    "decisions_needed",
    "next_recommended_task",
    "notes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/codex_phase_result.schema.json",
  "title": "Codex Phase Result",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ]
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "artifact_input": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ]
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
    },
    "test_run": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "summary"
      ]
    },
    "acceptance_criterion": {
      "type": "object",
      "properties": {
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "criterion",
        "status",
        "evidence"
      ]
    }
  }
}
