{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/segment_transcript_excerpt.schema.json",
  "title": "Segment Transcript Excerpt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "segment_id",
    "created_at",
    "producer",
    "inputs",
    "preview_sha256",
    "source_range",
    "transcript_segment_ids",
    "text",
    "words",
    "warnings",
    "status"
  ],
  "properties": {
    "schema_name": {"const": "segment_transcript_excerpt"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/id"},
    "segment_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "preview_sha256": {"$ref": "#/$defs/sha256"},
    "source_range": {"$ref": "#/$defs/range"},
    "transcript_segment_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "text": {"type": "string"},
    "words": {"type": "array", "items": {"$ref": "#/$defs/word"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["complete", "warning"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "time_us": {"type": "integer", "minimum": 0},
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_us", "end_us"],
      "properties": {
        "start_us": {"$ref": "#/$defs/time_us"},
        "end_us": {"$ref": "#/$defs/time_us"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_id",
        "segment_id",
        "text",
        "start_us",
        "end_us",
        "probability",
        "timing_status"
      ],
      "properties": {
        "word_id": {"$ref": "#/$defs/id"},
        "segment_id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1},
        "start_us": {"$ref": "#/$defs/time_us"},
        "end_us": {"$ref": "#/$defs/time_us"},
        "probability": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "timing_status": {"enum": ["original", "adjusted", "uncertain"]}
      }
    }
  }
}
