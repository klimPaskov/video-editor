{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/transition_plan.schema.json",
  "title": "Purposeful Structural Transition Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "timeline_basis",
    "transitions",
    "warnings"
  ],
  "properties": {
    "schema_name": {
      "const": "transition_plan"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_input"
      }
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "timeline_basis": {
      "const": "output"
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ],
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      }
    },
    "artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ],
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "outgoing_segment_id",
        "incoming_segment_id",
        "purpose",
        "transition_type",
        "range",
        "duration_us",
        "direction",
        "reason",
        "evidence_ids",
        "dialogue_protection",
        "sound",
        "confidence_components",
        "confidence",
        "policy_result",
        "approval_required",
        "fallback"
      ],
      "properties": {
        "transition_id": {
          "$ref": "#/$defs/identifier"
        },
        "outgoing_segment_id": {
          "$ref": "#/$defs/identifier"
        },
        "incoming_segment_id": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "enum": [
            "new_point",
            "new_chapter",
            "mode_change",
            "comparison",
            "before_after",
            "location_change",
            "return_from_visual_explanation"
          ]
        },
        "transition_type": {
          "enum": [
            "hard_cut",
            "j_cut",
            "l_cut",
            "short_crossfade",
            "dip_to_color",
            "swipe_left",
            "swipe_right",
            "push_left",
            "push_right",
            "blur_swipe",
            "chapter_transition"
          ]
        },
        "range": {
          "$ref": "#/$defs/time_range"
        },
        "duration_us": {
          "$ref": "#/$defs/time_us"
        },
        "direction": {
          "enum": [
            "none",
            "left",
            "right",
            "up",
            "down"
          ]
        },
        "easing": {
          "enum": [
            "linear",
            "ease_in",
            "ease_out",
            "ease_in_out",
            "smooth_ease_in_out"
          ]
        },
        "full_frame_coverage": {
          "type": "boolean"
        },
        "incoming_first_readable_frame_us": {
          "anyOf": [
            {
              "$ref": "#/$defs/time_us"
            },
            {
              "type": "null"
            }
          ]
        },
        "sound_sync_status": {
          "enum": [
            "not_required",
            "planned",
            "pass",
            "warning",
            "fail"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1
        },
        "dialogue_protection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "speech_overlaps",
            "first_incoming_word_us",
            "last_outgoing_word_us",
            "minimum_clearance_us",
            "intelligibility_risk"
          ],
          "properties": {
            "speech_overlaps": {
              "type": "boolean"
            },
            "first_incoming_word_us": {
              "anyOf": [
                {
                  "$ref": "#/$defs/time_us"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_outgoing_word_us": {
              "anyOf": [
                {
                  "$ref": "#/$defs/time_us"
                },
                {
                  "type": "null"
                }
              ]
            },
            "minimum_clearance_us": {
              "$ref": "#/$defs/time_us"
            },
            "intelligibility_risk": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          }
        },
        "sound": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cue_id",
                "asset_id",
                "asset_sha256",
                "license_id",
                "start_us",
                "end_us",
                "sync_peak_us",
                "gain_db",
                "fade_in_us",
                "fade_out_us",
                "duck_speech"
              ],
              "properties": {
                "cue_id": {
                  "$ref": "#/$defs/identifier"
                },
                "asset_id": {
                  "$ref": "#/$defs/identifier"
                },
                "asset_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "license_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start_us": {
                  "$ref": "#/$defs/time_us"
                },
                "end_us": {
                  "$ref": "#/$defs/time_us"
                },
                "sync_peak_us": {
                  "$ref": "#/$defs/time_us"
                },
                "gain_db": {
                  "type": "number",
                  "minimum": -60,
                  "maximum": 12
                },
                "fade_in_us": {
                  "$ref": "#/$defs/time_us"
                },
                "fade_out_us": {
                  "$ref": "#/$defs/time_us"
                },
                "duck_speech": {
                  "type": "boolean"
                },
                "transient_alignment_tolerance_us": {
                  "$ref": "#/$defs/time_us"
                },
                "speech_clearance_us": {
                  "$ref": "#/$defs/time_us"
                },
                "mix_policy": {
                  "enum": [
                    "speech_priority",
                    "foreground_effect",
                    "no_speech_overlap"
                  ]
                },
                "qa_status": {
                  "enum": [
                    "planned",
                    "pass",
                    "warning",
                    "fail"
                  ]
                }
              }
            }
          ]
        },
        "confidence_components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "structural_boundary",
            "timing",
            "visual_fit",
            "dialogue_safety",
            "sound_sync"
          ],
          "properties": {
            "structural_boundary": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "timing": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visual_fit": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "dialogue_safety": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sound_sync": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "policy_result": {
          "enum": [
            "auto_eligible",
            "review_required",
            "blocked",
            "fallback_only"
          ]
        },
        "approval_required": {
          "type": "boolean"
        },
        "fallback": {
          "enum": [
            "hard_cut",
            "j_cut",
            "l_cut",
            "short_crossfade",
            "no_transition"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transition_type": {
                "enum": [
                  "swipe_left",
                  "swipe_right",
                  "push_left",
                  "push_right",
                  "blur_swipe",
                  "chapter_transition"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "sound": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy_result": {
                "const": "review_required"
              }
            }
          },
          "then": {
            "properties": {
              "approval_required": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
