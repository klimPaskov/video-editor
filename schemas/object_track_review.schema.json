{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/object_track_review.schema.json",
  "title": "Reviewed object track",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "source_result",
    "segmentation_validation",
    "source_range",
    "object_id",
    "reviewed_frame_indices",
    "decision",
    "actor",
    "role",
    "findings",
    "fallback",
    "notes"
  ],
  "properties": {
    "schema_name": {
      "const": "object_track_review"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[0-9]{3,}$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "source_result": {
      "$ref": "#/$defs/file_ref"
    },
    "segmentation_validation": {
      "$ref": "#/$defs/file_ref"
    },
    "source_range": {
      "$ref": "#/$defs/source_range"
    },
    "object_id": {
      "type": "integer",
      "minimum": 1
    },
    "reviewed_frame_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "decision": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "continuity",
        "geometry",
        "occlusion"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/finding_status"
        },
        "continuity": {
          "$ref": "#/$defs/finding_status"
        },
        "geometry": {
          "$ref": "#/$defs/finding_status"
        },
        "occlusion": {
          "$ref": "#/$defs/finding_status"
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "on_uncertain"
      ],
      "properties": {
        "mode": {
          "const": "original_shot"
        },
        "on_uncertain": {
          "const": "keep_original"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ],
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_frame",
        "end_frame"
      ],
      "properties": {
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "finding_status": {
      "enum": [
        "pending",
        "pass",
        "warning",
        "fail"
      ]
    }
  }
}
