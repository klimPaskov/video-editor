{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/retry_request.schema.json",
  "title": "Local Stage Retry Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact_id", "project_id", "revision_id", "created_at", "stage", "previous_status", "stage_key", "retryable", "reason"],
  "properties": {
    "schema_name": {"const": "retry_request"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/revision"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "stage": {"type": "string", "minLength": 1},
    "previous_status": {"enum": ["failed", "cancelled"]},
    "stage_key": {"$ref": "#/$defs/sha256"},
    "retryable": {"const": true},
    "reason": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "revision": {"type": "string", "pattern": "^rev_[0-9]{3,}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
