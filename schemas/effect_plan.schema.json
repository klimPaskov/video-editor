{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effect_plan.schema.json",
  "title": "Effect plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_sha256",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ],
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "start_us",
          "end_us",
          "renderer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "cut",
              "caption",
              "motion_graphic",
              "sound_effect",
              "broll",
              "track_recolor",
              "track_replace",
              "inpainting",
              "person_matte",
              "background_replace",
              "text_between_subject_and_background",
              "picture_in_picture",
              "screen_focus",
              "purposeful_zoom"
            ]
          },
          "start_us": {
            "type": "integer",
            "minimum": 0
          },
          "end_us": {
            "type": "integer",
            "minimum": 1
          },
          "trigger_quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_prompt": {
            "type": [
              "string",
              "null"
            ]
          },
          "renderer": {
            "enum": [
              "ffmpeg",
              "remotion",
              "sam3",
              "matanyone2",
              "provider"
            ]
          },
          "fallback": {
            "type": [
              "string",
              "null"
            ]
          },
          "word_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "asset_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset_id",
                "sha256"
              ],
              "properties": {
                "asset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "worker": {
            "type": [
              "string",
              "null"
            ]
          },
          "intended_result": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "requires_approval": {
            "type": "boolean",
            "default": true
          },
          "linked_action_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focus_pacing_plan_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "focus_pacing_plan_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
