{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/segment_preview.schema.json",
  "title": "Logical Segment Preview Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "planning_key",
    "source_media",
    "transcript",
    "duration_us",
    "frame_rate",
    "policy",
    "segments",
    "warnings",
    "status"
  ],
  "properties": {
    "schema_name": {"const": "segment_preview"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "planning_key": {"$ref": "#/$defs/sha256"},
    "source_media": {"$ref": "#/$defs/media_ref"},
    "transcript": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/artifact_ref"}
      ]
    },
    "duration_us": {"$ref": "#/$defs/time_us"},
    "frame_rate": {"$ref": "#/$defs/rational"},
    "policy": {"$ref": "#/$defs/policy"},
    "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["complete", "warning"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "time_us": {"type": "integer", "minimum": 0},
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "media_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_segment_duration_us",
        "context_before_us",
        "context_after_us",
        "gap_merge_us",
        "derived_from"
      ],
      "properties": {
        "max_segment_duration_us": {"$ref": "#/$defs/time_us"},
        "context_before_us": {"$ref": "#/$defs/time_us"},
        "context_after_us": {"$ref": "#/$defs/time_us"},
        "gap_merge_us": {"$ref": "#/$defs/time_us"},
        "derived_from": {"enum": ["transcript", "fixed_windows"]}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_us", "end_us"],
      "properties": {
        "start_us": {"$ref": "#/$defs/time_us"},
        "end_us": {"$ref": "#/$defs/time_us"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "ordinal",
        "label",
        "transcript_segment_ids",
        "source_range",
        "preview_path",
        "preview_sha256",
        "expected_duration_us",
        "actual_duration_us",
        "frame_count",
        "diagnostics",
        "status"
      ],
      "properties": {
        "segment_id": {"$ref": "#/$defs/id"},
        "ordinal": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1},
        "transcript_segment_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "source_range": {"$ref": "#/$defs/range"},
        "preview_path": {"type": "string", "minLength": 1},
        "preview_sha256": {"$ref": "#/$defs/sha256"},
        "expected_duration_us": {"$ref": "#/$defs/time_us"},
        "actual_duration_us": {"$ref": "#/$defs/time_us"},
        "frame_count": {"type": "integer", "minimum": 1},
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decode", "video_stream", "audio_stream", "duration"],
          "properties": {
            "decode": {"enum": ["pass", "fail"]},
            "video_stream": {"enum": ["pass", "fail"]},
            "audio_stream": {"enum": ["pass", "fail"]},
            "duration": {"enum": ["pass", "fail"]}
          }
        },
        "status": {"enum": ["rendered", "reused"]}
      }
    }
  }
}
