{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segmentation_job.schema.json",
  "title": "SAM segmentation job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "input_path",
    "output_dir",
    "prompt"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "input_path": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[0-9]{3,}$"
    },
    "input": {
      "$ref": "#/$defs/file_ref"
    },
    "input_video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "frame_count",
        "frame_rate"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_rate": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "duration_us": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_range": {
      "$ref": "#/$defs/frame_range"
    },
    "expected_object_count": {
      "type": "integer",
      "minimum": 1
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mask_format",
        "lossless",
        "polarity"
      ],
      "properties": {
        "mask_format": {
          "const": "png_gray8"
        },
        "lossless": {
          "const": true
        },
        "polarity": {
          "const": "white_foreground"
        }
      }
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contract_version",
        "implementation_version"
      ],
      "properties": {
        "name": {
          "const": "sam3"
        },
        "contract_version": {
          "type": "string",
          "minLength": 1
        },
        "implementation_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "point",
            "box",
            "mask"
          ]
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "point_labels": {
          "type": "array",
          "items": {
            "enum": [
              0,
              1
            ]
          }
        },
        "box_xywh": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "mask_path": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "type"
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "const": "text"
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "point"
              }
            }
          },
          "then": {
            "required": [
              "points",
              "point_labels"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "box"
              }
            }
          },
          "then": {
            "required": [
              "box_xywh"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "mask"
              }
            }
          },
          "then": {
            "required": [
              "mask_path"
            ]
          }
        }
      ]
    },
    "start_frame": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "end_frame": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "gpus": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "config_sha256",
          "project_id",
          "revision_id",
          "input",
          "input_video",
          "source_range",
          "expected_object_count",
          "output_contract",
          "approval",
          "worker",
          "runtime",
          "start_frame",
          "end_frame"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "frame_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_frame",
        "end_frame"
      ],
      "properties": {
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Half-open frame range; the service validator enforces end_frame > start_frame."
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_repository",
        "upstream_commit",
        "checkpoint_id",
        "checkpoint_sha256",
        "checkpoint_path",
        "access"
      ],
      "properties": {
        "upstream_repository": {
          "type": "string",
          "format": "uri"
        },
        "upstream_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "checkpoint_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "checkpoint_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "python": {
          "type": "string"
        },
        "pytorch": {
          "type": "string"
        },
        "cuda": {
          "type": "string"
        },
        "device": {
          "type": "string"
        },
        "access": {
          "enum": [
            "pending",
            "approved",
            "blocked"
          ]
        },
        "runtime_approval": {
          "anyOf": [
            {"$ref": "#/$defs/runtime_approval"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "access": {
                "const": "approved"
              }
            }
          },
          "then": {
            "required": ["runtime_approval"],
            "properties": {
              "runtime_approval": {
                "$ref": "#/$defs/runtime_approval"
              }
            }
          }
        }
      ]
    },
    "runtime_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
