{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/join_qa_report.schema.json",
  "title": "Rendered Cut Join QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "render_artifact_id",
    "summary",
    "joins",
    "overall_status"
  ],
  "properties": {
    "schema_name": {
      "const": "join_qa_report"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_input"
      }
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "render_artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "transcription_provenance": {
      "$ref": "#/$defs/transcription_provenance"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_joins",
        "passed",
        "warnings",
        "failed",
        "repaired",
        "cuts_per_minute",
        "average_kept_fragment_us"
      ],
      "properties": {
        "total_joins": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "repaired": {
          "type": "integer",
          "minimum": 0
        },
        "cuts_per_minute": {
          "type": "number",
          "minimum": 0
        },
        "average_kept_fragment_us": {
          "$ref": "#/$defs/time_us"
        }
      }
    },
    "joins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/join"
      }
    },
    "overall_status": {
      "enum": [
        "pass",
        "warning",
        "fail"
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ],
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      }
    },
    "artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "duration_us",
        "full_decode_status"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/file_ref"
        },
        "duration_us": {
          "$ref": "#/$defs/time_us"
        },
        "full_decode_status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ],
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transcription_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "model_identifier",
        "device"
      ],
      "properties": {
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "model_identifier": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "join_id",
        "proposal_ids",
        "output_join_us",
        "preview_range",
        "join_strategy",
        "transcript_check",
        "audio_check",
        "visual_check",
        "pacing_check",
        "confidence",
        "status",
        "repair_action",
        "review_required"
      ],
      "properties": {
        "join_id": {
          "$ref": "#/$defs/identifier"
        },
        "proposal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1
        },
        "output_join_us": {
          "$ref": "#/$defs/time_us"
        },
        "preview_range": {
          "$ref": "#/$defs/time_range"
        },
        "preview": {
          "$ref": "#/$defs/preview"
        },
        "diagnostic_window": {
          "$ref": "#/$defs/time_range"
        },
        "join_strategy": {
          "enum": [
            "hard_cut",
            "hard_cut_with_micro_audio_crossfade",
            "adjusted_handles",
            "room_tone",
            "j_cut",
            "l_cut",
            "broll_cover",
            "alternate_coverage",
            "purposeful_punch_in"
          ]
        },
        "transcript_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_text",
            "rendered_text",
            "missing_words",
            "unexpected_words",
            "duplicate_words",
            "grammar_status",
            "meaning_status"
          ],
          "properties": {
            "approved_text": {
              "type": "string"
            },
            "rendered_text": {
              "type": "string"
            },
            "missing_words": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unexpected_words": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "duplicate_words": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "grammar_status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "meaning_status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            }
          }
        },
        "semantic_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protected_content_removed",
            "unintended_meaning_change",
            "meaning_status",
            "notes"
          ],
          "properties": {
            "protected_content_removed": {
              "type": "boolean"
            },
            "unintended_meaning_change": {
              "type": "boolean"
            },
            "meaning_status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "audio_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clipped_syllable",
            "click_or_pop",
            "room_tone_jump",
            "speech_rhythm",
            "status"
          ],
          "properties": {
            "clipped_syllable": {
              "type": "boolean"
            },
            "click_or_pop": {
              "type": "boolean"
            },
            "room_tone_jump": {
              "type": "boolean"
            },
            "speech_rhythm": {
              "enum": [
                "natural",
                "slightly_tight",
                "rushed",
                "broken"
              ]
            },
            "status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "context_clipped_samples": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "boundary_clipped_samples": {
              "type": "integer",
              "minimum": 0
            },
            "boundary_clipping_known": {
              "type": "boolean"
            }
          }
        },
        "visual_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "black_flash",
            "freeze",
            "duplicate_frame",
            "face_or_body_jump",
            "screen_state_jump",
            "status"
          ],
          "properties": {
            "black_flash": {
              "type": "boolean"
            },
            "freeze": {
              "type": "boolean"
            },
            "duplicate_frame": {
              "type": "boolean"
            },
            "face_or_body_jump": {
              "enum": [
                "none",
                "acceptable",
                "distracting"
              ]
            },
            "screen_state_jump": {
              "enum": [
                "none",
                "understandable",
                "unexplained"
              ]
            },
            "status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            },
            "context_black_flash": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "context_freeze": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "boundary_black_known": {
              "type": "boolean"
            },
            "boundary_freeze_known": {
              "type": "boolean"
            }
          }
        },
        "pacing_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_cuts_per_minute",
            "kept_before_us",
            "kept_after_us",
            "speech_rate_change_percent",
            "status"
          ],
          "properties": {
            "local_cuts_per_minute": {
              "type": "number",
              "minimum": 0
            },
            "kept_before_us": {
              "$ref": "#/$defs/time_us"
            },
            "kept_after_us": {
              "$ref": "#/$defs/time_us"
            },
            "speech_rate_change_percent": {
              "type": "number",
              "minimum": -100,
              "maximum": 500
            },
            "status": {
              "enum": [
                "pass",
                "warning",
                "fail"
              ]
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "repaired"
          ]
        },
        "repair_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_required": {
          "type": "boolean"
        }
      }
    }
  }
}
