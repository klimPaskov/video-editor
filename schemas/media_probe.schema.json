{
  "type": "object",
  "properties": {
    "schema_name": {
      "const": "media_probe"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_input"
      }
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "format_name": {
      "type": "string",
      "minLength": 1
    },
    "duration_us": {
      "$ref": "#/$defs/time_us"
    },
    "bit_rate_bps": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media_stream"
      },
      "minItems": 1
    },
    "ffprobe_version": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "valid",
        "warning",
        "invalid"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "format_name",
    "duration_us",
    "bit_rate_bps",
    "streams",
    "ffprobe_version",
    "warnings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/media_probe.schema.json",
  "title": "Media Probe Report",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ]
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "artifact_input": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ]
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
    },
    "media_stream": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": [
            "video",
            "audio",
            "subtitle",
            "data",
            "attachment",
            "unknown"
          ]
        },
        "codec_name": {
          "type": "string",
          "minLength": 1
        },
        "time_base": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "start_time_us": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_us": {
          "anyOf": [
            {
              "$ref": "#/$defs/time_us"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_rate_hz": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "channels": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rotation_degrees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "pixel_aspect_ratio": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "color_space": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "color_primaries": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "color_transfer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "color_range": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "variable_frame_rate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "index",
        "type",
        "codec_name",
        "time_base",
        "start_time_us",
        "duration_us",
        "width",
        "height",
        "frame_rate",
        "sample_rate_hz",
        "channels"
      ]
    }
  }
}
