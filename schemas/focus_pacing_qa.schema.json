{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/focus_pacing_qa.schema.json",
  "title": "Focus and Pacing QA Report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "focus_pacing_qa"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "revision_id": {"$ref": "#/$defs/revision"},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact_input"}},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "overall_status": {"enum": ["pass", "warning", "fail"]},
    "final_ready": {"type": "boolean"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "required_failures": {"type": "integer", "minimum": 0},
    "warnings_count": {"type": "integer", "minimum": 0}
  },
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "overall_status",
    "final_ready",
    "findings",
    "required_failures",
    "warnings_count"
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "revision": {"type": "string", "pattern": "^rev_[0-9]{3,}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "check_code",
        "status",
        "severity",
        "message",
        "required",
        "evidence"
      ],
      "properties": {
        "finding_id": {"$ref": "#/$defs/identifier"},
        "check_code": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "warning", "fail"]},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "message": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "evidence": {"type": "object"}
      }
    }
  }
}
