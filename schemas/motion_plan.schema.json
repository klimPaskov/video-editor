{
  "type": "object",
  "properties": {
    "schema_name": {
      "const": "motion_plan"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_input"
      }
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "renderer": {
      "type": "string",
      "minLength": 1
    },
    "target_width": {
      "type": "integer",
      "minimum": 1
    },
    "target_height": {
      "type": "integer",
      "minimum": 1
    },
    "frame_rate": {
      "$ref": "#/$defs/rational"
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/motion_cue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "renderer",
    "target_width",
    "target_height",
    "frame_rate",
    "cues",
    "warnings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/motion_plan.schema.json",
  "title": "Motion Cue Plan",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ]
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "artifact_input": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ]
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
    },
    "motion_cue": {
      "type": "object",
      "properties": {
        "cue_id": {
          "$ref": "#/$defs/identifier"
        },
        "cue_type": {
          "enum": [
            "key_point",
            "counter",
            "comparison",
            "definition",
            "chapter",
            "quote",
            "highlight"
          ]
        },
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        },
        "template_id": {
          "$ref": "#/$defs/identifier"
        },
        "payload": {
          "type": "object"
        },
        "region": {
          "enum": [
            "full",
            "top",
            "bottom",
            "left",
            "right",
            "custom"
          ]
        },
        "z_index": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "approval_state": {
          "enum": [
            "proposed",
            "approved",
            "rejected"
          ]
        },
        "fallback_template_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "cue_id",
        "cue_type",
        "start_us",
        "end_us",
        "template_id",
        "payload",
        "region",
        "z_index",
        "rationale",
        "approval_state",
        "fallback_template_id"
      ]
    }
  }
}
