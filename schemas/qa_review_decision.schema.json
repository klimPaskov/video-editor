{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/qa_review_decision.schema.json",
  "title": "Human QA Review Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "artifact_id", "project_id", "revision_id",
    "created_at", "producer", "inputs", "packet", "decision_record", "reviewer",
    "decisions", "summary", "status", "notes"
  ],
  "properties": {
    "schema_name": {"const": "qa_review_decision"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/revision"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/artifact_input"}
    },
    "packet": {"$ref": "#/$defs/file_ref"},
    "decision_record": {"const": "recorded"},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/decision"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "status": {"enum": ["partial", "changes_requested", "reviewed"]},
    "notes": {"type": "string"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "revision": {"type": "string", "pattern": "^rev_[0-9]{3,}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_us", "end_us"],
      "properties": {
        "start_us": {"type": "integer", "minimum": 0},
        "end_us": {"type": "integer", "minimum": 1}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "role", "reviewed_at"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "reviewed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "check_code", "source_finding_id", "packet_item_sha256", "decision",
        "reason", "time_range", "evidence"
      ],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "check_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "source_finding_id": {"$ref": "#/$defs/id"},
        "packet_item_sha256": {"$ref": "#/$defs/sha256"},
        "decision": {
          "enum": [
            "repair", "reviewed_non_defect", "intentional_static", "false_positive",
            "accepted_risk", "reject_candidate"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "time_range": {"anyOf": [{"$ref": "#/$defs/range"}, {"type": "null"}]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file_ref"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_item_count", "decided_item_count", "pending_item_count", "repair_count",
        "reject_count", "classification_counts"
      ],
      "properties": {
        "packet_item_count": {"type": "integer", "minimum": 1},
        "decided_item_count": {"type": "integer", "minimum": 1},
        "pending_item_count": {"type": "integer", "minimum": 0},
        "repair_count": {"type": "integer", "minimum": 0},
        "reject_count": {"type": "integer", "minimum": 0},
        "classification_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
