{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/occluder_manifest.schema.json",
  "title": "Reviewed tracked foreground occluder manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "status",
    "source",
    "source_range",
    "track",
    "mask",
    "output",
    "video",
    "alpha",
    "validation",
    "layer",
    "fallback",
    "commands",
    "warnings"
  ],
  "properties": {
    "schema_name": {"const": "occluder_manifest"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "revision_id": {"type": "string", "pattern": "^rev_[0-9]{3,}$"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/artifact_input"}},
    "status": {"enum": ["complete", "failed"]},
    "source": {"$ref": "#/$defs/file_ref"},
    "source_range": {"$ref": "#/$defs/frame_range"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_result", "segmentation_validation", "review", "object_id"],
      "properties": {
        "source_result": {"$ref": "#/$defs/file_ref"},
        "segmentation_validation": {"$ref": "#/$defs/file_ref"},
        "review": {"$ref": "#/$defs/file_ref"},
        "object_id": {"type": "integer", "minimum": 1},
        "decision": {"const": "approved"},
        "findings": {"type": "object", "additionalProperties": {"const": "pass"}}
      }
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "encoding", "polarity", "frames"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "encoding": {"const": "png_gray8"},
        "polarity": {"const": "white_foreground"},
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame_index", "visible", "source", "staged"],
            "properties": {
              "frame_index": {"type": "integer", "minimum": 0},
              "visible": {"type": "boolean"},
              "source": {"$ref": "#/$defs/file_ref"},
              "staged": {"$ref": "#/$defs/file_ref"}
            }
          }
        }
      }
    },
    "output": {"$ref": "#/$defs/file_ref"},
    "video": {"$ref": "#/$defs/video"},
    "alpha": {"$ref": "#/$defs/alpha"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_identity",
        "source_range",
        "track_review",
        "mask_sequence",
        "full_decode",
        "alpha_plane",
        "alpha_range",
        "alpha_polarity",
        "dimensions",
        "frame_count",
        "frame_rate",
        "duration"
      ],
      "properties": {
        "source_identity": {"enum": ["pass", "fail"]},
        "source_range": {"enum": ["pass", "fail"]},
        "track_review": {"enum": ["pass", "fail"]},
        "mask_sequence": {"enum": ["pass", "fail"]},
        "full_decode": {"enum": ["pass", "fail"]},
        "alpha_plane": {"enum": ["pass", "fail"]},
        "alpha_range": {"enum": ["pass", "fail"]},
        "alpha_polarity": {"enum": ["pass", "fail"]},
        "dimensions": {"enum": ["pass", "fail"]},
        "frame_count": {"enum": ["pass", "fail"]},
        "frame_rate": {"enum": ["pass", "fail"]},
        "duration": {"enum": ["pass", "fail"]}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_id", "asset_id", "role", "z_index", "start_frame", "duration_frames"],
      "properties": {
        "layer_id": {"$ref": "#/$defs/identifier"},
        "asset_id": {"$ref": "#/$defs/identifier"},
        "role": {"const": "front"},
        "z_index": {"type": "integer"},
        "start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "on_uncertain"],
      "properties": {
        "mode": {"const": "original_shot"},
        "on_uncertain": {"const": "keep_original"}
      }
    },
    "commands": {"type": "array", "items": {"$ref": "#/$defs/process_command"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "frame_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame"],
      "properties": {
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 1}
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "width", "height", "frame_rate", "pixel_format", "frame_count", "duration_us"],
      "properties": {
        "codec": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frame_rate": {"$ref": "#/$defs/rational"},
        "pixel_format": {"type": "string", "minLength": 1},
        "frame_count": {"type": "integer", "minimum": 1},
        "duration_us": {"type": "integer", "minimum": 0}
      }
    },
    "alpha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "mean", "polarity", "sampled_frames"],
      "properties": {
        "min": {"type": "number", "minimum": 0, "maximum": 255},
        "max": {"type": "number", "minimum": 0, "maximum": 255},
        "mean": {"type": "number", "minimum": 0, "maximum": 255},
        "polarity": {"const": "mixed"},
        "sampled_frames": {"type": "integer", "minimum": 1}
      }
    },
    "process_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "working_directory", "exit_code", "elapsed_ms", "version"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "working_directory": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
