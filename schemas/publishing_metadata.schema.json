{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/publishing_metadata.schema.json",
  "title": "Final Publishing Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "artifact_id", "project_id", "revision_id", "created_at", "candidate_sha256", "captions", "transcript", "chapters", "description_draft", "warnings"],
  "properties": {
    "schema_name": {"const": "publishing_metadata"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/revision"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "captions": {"type": "object", "additionalProperties": false, "required": ["ass", "webvtt", "text"], "properties": {"ass": {"$ref": "#/$defs/file_ref"}, "webvtt": {"$ref": "#/$defs/file_ref"}, "text": {"$ref": "#/$defs/file_ref"}}},
    "transcript": {"$ref": "#/$defs/file_ref"},
    "chapters": {"type": "array", "items": {"$ref": "#/$defs/chapter"}},
    "description_draft": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "revision": {"type": "string", "pattern": "^rev_[0-9]{3,}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "file_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "path", "sha256", "size_bytes"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "chapter": {"type": "object", "additionalProperties": false, "required": ["start_us", "title", "source", "confidence"], "properties": {"start_us": {"type": "integer", "minimum": 0}, "title": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}
  }
}
