{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/contact_sheet_report.schema.json",
  "title": "Visual contact-sheet evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "outputs",
    "findings",
    "warnings",
    "status"
  ],
  "properties": {
    "schema_name": {"const": "contact_sheet_report"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "revision_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contact_sheet"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["pass", "warning", "fail"]}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "contact_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "path", "sha256", "size_bytes", "frame_indices", "filter_prefix", "command"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "frame_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "filter_prefix": {"type": ["string", "null"]},
        "command": {"$ref": "#/$defs/process_command"}
      }
    },
    "process_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "working_directory", "exit_code", "elapsed_ms", "version"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "working_directory": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "severity", "summary", "frame_indices"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "warning", "fail", "not_applicable"]},
        "severity": {"enum": ["info", "warning", "error"]},
        "summary": {"type": "string", "minLength": 1},
        "frame_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    }
  }
}
