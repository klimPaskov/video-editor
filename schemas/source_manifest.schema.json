{
  "type": "object",
  "properties": {
    "schema_name": {
      "const": "source_manifest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_input"
      }
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ingest_mode": {
      "enum": [
        "reference",
        "copy"
      ]
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "managed_path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "modified_at_ns": {
      "type": "integer",
      "minimum": 0
    },
    "media_duration_us": {
      "$ref": "#/$defs/time_us"
    },
    "probe_artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "immutable": {
      "const": true
    },
    "ingest_stage_key": {
      "$ref": "#/$defs/sha256"
    },
    "proxy_artifact_ids": {
      "type": "object",
      "properties": {
        "edit": {
          "$ref": "#/$defs/identifier"
        },
        "speech": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "ingest_mode",
    "source_path",
    "managed_path",
    "sha256",
    "size_bytes",
    "modified_at_ns",
    "media_duration_us",
    "probe_artifact_id",
    "immutable"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/source_manifest.schema.json",
  "title": "Source Manifest",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ]
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "artifact_input": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ]
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
    }
  }
}
