{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/segment_qa_report.schema.json",
  "title": "Segment Quality Assurance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "artifact_id", "project_id", "revision_id",
    "created_at", "producer", "inputs", "scope", "media", "comparison",
    "caption_plan", "findings", "summary", "overall_status", "final_ready"
  ],
  "properties": {
    "schema_name": {"const": "segment_qa_report"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "revision_id": {"$ref": "#/$defs/revision"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "scope": {"$ref": "#/$defs/scope"},
    "media": {"$ref": "#/$defs/file_ref"},
    "comparison": {"anyOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
    "caption_plan": {"anyOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]},
    "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}},
    "summary": {"$ref": "#/$defs/summary"},
    "overall_status": {"enum": ["pass", "warning", "fail"]},
    "final_ready": {"type": "boolean"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "revision": {"type": "string", "pattern": "^rev_[0-9]{3,}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "time_us": {"type": "integer", "minimum": 0},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_version", "stage", "adapter", "adapter_version"],
      "properties": {
        "application_version": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_us", "end_us"],
      "properties": {
        "start_us": {"$ref": "#/$defs/time_us"},
        "end_us": {"$ref": "#/$defs/time_us"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_range", "output_range"],
      "properties": {
        "source_range": {"$ref": "#/$defs/range"},
        "output_range": {"$ref": "#/$defs/range"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id", "check_code", "status", "severity", "message", "evidence", "required"
      ],
      "properties": {
        "finding_id": {"$ref": "#/$defs/id"},
        "check_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "status": {"enum": ["pass", "fail", "warning", "skipped"]},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "message": {"type": "string", "minLength": 1},
        "time_range": {"anyOf": [{"$ref": "#/$defs/range"}, {"type": "null"}]},
        "evidence": {"type": "object"},
        "required": {"type": "boolean"},
        "repair_hint": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "warnings", "failed", "skipped", "required_failures"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "required_failures": {"type": "integer", "minimum": 0}
      }
    }
  }
}
