{
  "type": "object",
  "properties": {
    "schema_name": {
      "const": "broll_plan"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_input"
      }
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "estimated_total": {
      "$ref": "#/$defs/money"
    },
    "reserve_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/broll_request"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "currency",
    "estimated_total",
    "reserve_percent",
    "requests",
    "warnings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/broll_plan.schema.json",
  "title": "B-roll Request Plan",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ]
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "artifact_input": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ]
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
    },
    "broll_request": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        },
        "transcript_context": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "literal",
            "conceptual",
            "diagram",
            "licensed_footage"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "negative_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration_us": {
          "$ref": "#/$defs/time_us"
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "factual_sensitivity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "fallback": {
          "enum": [
            "none",
            "base_video",
            "local_motion",
            "licensed_asset"
          ]
        },
        "asset_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "asset_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "collision_group": {
          "type": "string",
          "minLength": 1
        },
        "minimum_spacing_us": {
          "$ref": "#/$defs/time_us"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_cost": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "amount": {
                  "$ref": "#/$defs/money"
                },
                "estimate_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "currency",
                "amount",
                "estimate_id"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_state": {
          "enum": [
            "proposed",
            "approved",
            "rejected",
            "blocked"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "start_us",
        "end_us",
        "transcript_context",
        "rationale",
        "mode",
        "prompt",
        "negative_constraints",
        "duration_us",
        "aspect_ratio",
        "factual_sensitivity",
        "fallback",
        "provider",
        "model",
        "estimated_cost",
        "approval_state"
      ]
    }
  }
}
