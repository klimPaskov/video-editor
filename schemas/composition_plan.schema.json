{
  "type": "object",
  "properties": {
    "schema_name": {
      "const": "composition_plan"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_input"
      }
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "duration_us": {
      "$ref": "#/$defs/time_us"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "frame_rate": {
      "$ref": "#/$defs/rational"
    },
    "video_layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/video_layer"
      },
      "minItems": 1
    },
    "audio_tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audio_track"
      },
      "minItems": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "duration_us",
    "width",
    "height",
    "frame_rate",
    "video_layers",
    "audio_tracks",
    "warnings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/composition_plan.schema.json",
  "title": "Composition Plan",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ]
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "artifact_input": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ]
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
    },
    "video_layer": {
      "type": "object",
      "properties": {
        "layer_id": {
          "$ref": "#/$defs/identifier"
        },
        "layer_type": {
          "enum": [
            "base_video",
            "broll",
            "motion",
            "captions",
            "logo",
            "disclosure",
            "transition"
          ]
        },
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        },
        "source_artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "z_index": {
          "type": "integer",
          "minimum": 0
        },
        "region": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "layer_id",
        "layer_type",
        "start_us",
        "end_us",
        "source_artifact_id",
        "z_index",
        "region"
      ]
    },
    "audio_track": {
      "type": "object",
      "properties": {
        "track_id": {
          "$ref": "#/$defs/identifier"
        },
        "track_type": {
          "enum": [
            "production",
            "music",
            "sound_effect"
          ]
        },
        "source_artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        },
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 24
        },
        "ducking_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "track_id",
        "track_type",
        "source_artifact_id",
        "start_us",
        "end_us",
        "gain_db",
        "ducking_group"
      ]
    }
  }
}
