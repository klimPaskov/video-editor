{
  "type": "object",
  "properties": {
    "schema_name": {
      "const": "edit_decision_list"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_input"
      }
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_duration_us": {
      "$ref": "#/$defs/time_us"
    },
    "expected_output_duration_us": {
      "$ref": "#/$defs/time_us"
    },
    "keep_ranges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keep_range"
      },
      "minItems": 1
    },
    "source_to_output_mapping": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping_range"
      }
    },
    "deletions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deletion"
      }
    },
    "approval_record_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "project_id",
    "revision_id",
    "created_at",
    "producer",
    "inputs",
    "config_sha256",
    "source_duration_us",
    "expected_output_duration_us",
    "keep_ranges",
    "deletions",
    "approval_record_ids",
    "policy_id",
    "policy_version"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoedit.local/schemas/edit_decision_list.schema.json",
  "title": "Canonical Edit Decision List",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "time_us": {
      "type": "integer",
      "minimum": 0
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start_us": {
          "$ref": "#/$defs/time_us"
        },
        "end_us": {
          "$ref": "#/$defs/time_us"
        }
      },
      "additionalProperties": false,
      "required": [
        "start_us",
        "end_us"
      ]
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "artifact_input": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "application_version",
        "stage",
        "adapter",
        "adapter_version"
      ]
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ]
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
    },
    "keep_range": {
      "type": "object",
      "properties": {
        "segment_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_start_us": {
          "$ref": "#/$defs/time_us"
        },
        "source_end_us": {
          "$ref": "#/$defs/time_us"
        },
        "output_start_us": {
          "$ref": "#/$defs/time_us"
        },
        "output_end_us": {
          "$ref": "#/$defs/time_us"
        }
      },
      "additionalProperties": false,
      "required": [
        "segment_id",
        "source_start_us",
        "source_end_us",
        "output_start_us",
        "output_end_us"
      ]
    },
    "mapping_range": {
      "type": "object",
      "properties": {
        "source_start_us": {"$ref": "#/$defs/time_us"},
        "source_end_us": {"$ref": "#/$defs/time_us"},
        "output_start_us": {"$ref": "#/$defs/time_us"},
        "output_end_us": {"$ref": "#/$defs/time_us"}
      },
      "additionalProperties": false,
      "required": [
        "source_start_us",
        "source_end_us",
        "output_start_us",
        "output_end_us"
      ]
    },
    "deletion": {
      "type": "object",
      "properties": {
        "deletion_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_start_us": {
          "$ref": "#/$defs/time_us"
        },
        "source_end_us": {
          "$ref": "#/$defs/time_us"
        },
        "proposal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1
        },
        "approval_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "deletion_id",
        "source_start_us",
        "source_end_us",
        "proposal_ids",
        "approval_ids",
        "reason"
      ]
    }
  }
}
