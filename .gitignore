# Local configuration and credentials
.env
*.token
*.key

# Local media, project data, and runtime evidence. Keep these out of the
# public repository; source media and generated deliverables belong on the
# operator's machine or in an approved delivery store.
projects/
outputs/
source/
.codex/evidence/
.p11*/
.p10*/
.p7*/
p10-*/
p7-*/
