assets/private/
*.mp4
*.mov
*.mkv
*.wav
*.flac
*.webm
*.png
*.jpg
*.jpeg
!tests/fixtures/.gitkeep

# GPU worker environments and upstream clones
workers/*/.venv/
workers/*/upstream/
workers/*/models/
workers/*/outputs/

# Codex results are local by default
.codex/results/*.json
!.codex/results/.gitkeep

